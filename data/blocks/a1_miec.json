          ["pieniądze (pl)", "pieniądze", "mam pieniądze"]
        ]
      }
    },
    {
      "title": "A fixed phrase",
      "title_pl": "Stała fraza",
      "body": "Learn nie mam czasu as a whole phrase: I don’t have time.",
      "body_pl": "Naucz się w całości: nie mam czasu."
    },
    {
      "title": "Examples",
      "examples": [

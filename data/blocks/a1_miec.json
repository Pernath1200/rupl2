        "headers": ["Nominative", "As object (acc)", "In a phrase"],
        "rows": [
          ["kawa (f)", "kawę", "mam kawę"],
          ["herbata (f)", "herbatę", "chcę herbatę"],
          ["książka (f)", "książkę", "mam książkę"],

{
  "id": "a1_acc_gym",
  "title": "Siłownia · biernik",
  "title_en": "Accusative gym · nom vs acc",
  "level": "A1",
  "tree_node": "a1_acc_gym",
  "kind": "morphology",
  "default_direction": "en_to_pl",
  "type": {
    "mode": "full_word"
  },
  "check": {
    "sequence": [
      "match",
      "quiz"
    ]
  },
  "note": "Volume after a1_miec. Drill m/f/n Acc · nom vs acc forms · nom vs acc sentences · error correction. Known lemmas only. Positive mieć only (no negation).",
  "focus_structures": [
    "miec_acc",
    "miec_present",
    "to_jest"
  ],
  "intro": [
    {
      "title": "Gym goal",
      "title_pl": "Cel siłowni",
      "body": "Repeat until automatic: (1) name something = nominative, (2) have / want it = accusative. Three genders behave differently.",
      "body_pl": "Powtarzaj: nazwać = mianownik · mieć = biernik. Trzy rodzaje — trzy wzorce."
    },
    {
      "title": "Nom sentence vs Acc sentence",
      "title_pl": "Zdanie w mianowniku vs bierniku",
      "body": "To jest X names the thing (nominative after to jest).\nMam X puts the thing in the object slot (accusative after mieć).",
      "body_pl": "To jest X — nazywasz (mianownik).\nMam X — masz to (biernik).",
      "examples": [
        {
          "en": "This is coffee. (name it)",
          "pl": "To jest kawa."
        },
        {
          "en": "I have coffee. (have it)",
          "pl": "Mam kawę."
        },
        {
          "en": "This is a book.",
          "pl": "To jest książka."
        },
        {
          "en": "I have a book.",
          "pl": "Mam książkę."
        },
        {
          "en": "This is beer.",
          "pl": "To jest piwo."
        },
        {
          "en": "I have beer.",
          "pl": "Mam piwo."
        }
      ]
    },
    {
      "title": "Forms by gender (drill set)",
      "title_pl": "Formy według rodzaju",
      "body": "Same words you already know — watch what changes.",
      "body_pl": "Znane słowa — patrz, co się zmienia.",
      "table": {
        "headers": [
          "Gender",
          "Nom (to jest…)",
          "Acc (mam…)",
          "Change?"
        ],
        "rows": [
          [
            "feminine",
            "kawa · książka · woda · siostra",
            "kawę · książkę · wodę · siostrę",
            "yes: -a → -ę"
          ],
          [
            "masculine thing",
            "dom · sklep",
            "dom · sklep",
            "often no change"
          ],
          [
            "masculine person/animal",
            "kot",
            "kota",
            "often -a"
          ],
          [
            "neuter",
            "piwo · miasto",
            "piwo · miasto",
            "often no change"
          ]
        ]
      }
    },
    {
      "title": "Spot the error",
      "title_pl": "Znajdź błąd",
      "body": "In Kontrola you will fix wrong case: e.g. Mam kawa. is wrong → Mam kawę. · To jest kawę. is wrong → To jest kawa.",
      "body_pl": "W Kontroli poprawiasz przypadek: Mam kawa. → Mam kawę. · To jest kawę. → To jest kawa."
    }
  ],

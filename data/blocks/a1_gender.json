  "intro": [
    {
      "title": "Nouns have gender",
      "title_pl": "Rzeczowniki mają rodzaj",
      "body": "Every Polish noun is masculine, feminine, or neuter. You will use that every time you describe or point to something.",
      "body_pl": "Każdy rzeczownik jest męski, żeński albo nijaki."
    },
    {
      "title": "Three genders",
      "title_pl": "Trzy rodzaje",
      "table": {
        "headers": [
          "Rodzaj",
          "Często",
          "Słowa na dziś"
        ],
        "rows": [
          [
            "męski",
            "spółgłoska na końcu",
            "dom · kot · sklep"
          ],
          [
            "żeński",
            "końcówka -a",
            "kawa · książka · herbata"
          ],
          [
            "nijaki",
            "końcówka -o / -e",
            "miasto · piwo · morze"
          ]
        ]
      }
    },
    {
      "title": "To jest…",
      "title_pl": "To jest…",
      "body": "Use To jest + the noun to say “this is…”.",
      "body_pl": "To jest + rzeczownik = „this is…”.",
      "examples": [
        {
          "en": "This is a house.",
          "pl": "To jest dom."
        },
